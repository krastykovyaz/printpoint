# Gmail account used to send new order notifications.
# For Gmail, use a 16-character App Password, not your regular password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Inbox that should receive each print order (can be different from GMAIL_USER).
PRINT_SHOP_EMAIL=orders@example.com

# Optional: displayed in the confirmation email's sender name.
SHOP_NAME=PrintPoint

# Optional: default local development port.
PORT=3030

# Optional: also notify a Telegram chat when a new order comes in.
# Create a bot via @BotFather to get a token, and message the bot (or add it
# to a group) to find the chat id via https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Required for the "Printing" / "Order ready" buttons on Telegram order
# notifications to work: the public HTTPS URL Telegram sends button clicks to.
PUBLIC_URL=https://your-domain.example

# Optional but recommended: a random token Telegram echoes back on every
# webhook call, checked against the X-Telegram-Bot-Api-Secret-Token header
# so random internet traffic can't trigger customer emails.
TELEGRAM_WEBHOOK_SECRET=a-long-random-string
