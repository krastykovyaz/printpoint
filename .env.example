# Gmail account used to send order notifications.
# For Gmail, use a 16-character App Password, not your regular password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Inbox that should receive each print order (can be different from GMAIL_USER).
PRINT_SHOP_EMAIL=orders@example.com

# Optional: sender name shown on every email.
SHOP_NAME=PrintPoint

# Optional: address and port the app listens on. Keep HOST on 127.0.0.1 behind nginx.
HOST=127.0.0.1
PORT=3030

# Optional: also notify a Telegram chat when a new order comes in.
# Create a bot via @BotFather to get a token, and message the bot to find
# the chat id via https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Required for the Telegram buttons and commands (Printing / Delivery /
# Order ready, /stats, /skip): the public HTTPS URL Telegram calls, and a
# random secret Telegram echoes back on every call. Without the secret the
# webhook ignores everything.
PUBLIC_URL=https://your-domain.example
TELEGRAM_WEBHOOK_SECRET=a-long-random-string

# Optional: backstop for orders never marked ready. Contact details are normally
# deleted when you tap "Order ready"; this blanks any that remain after N days.
RETENTION_DAYS=30

# Optional: time zone used for "today" in the /stats report.
STATS_TIMEZONE=Europe/Luxembourg

# Optional: order attempts allowed per IP per 15 minutes, and in total per day.
ORDER_RATE_LIMIT=8
ORDER_DAILY_LIMIT=200

# Optional: lets the Telegram "Print on printer" button send jobs to a print agent
# (see README). Use a long random value, e.g. `openssl rand -hex 24`. Leave empty to
# keep the CV off the server entirely.
PRINT_AGENT_TOKEN=
# Hours an unprinted CV may wait for the print button before it is deleted.
PRINT_HOLD_HOURS=48
