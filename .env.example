# Gmail account used to send new order notifications.
# For Gmail, use a 16-character App Password, not your regular password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Inbox that should receive each print order (can be different from GMAIL_USER).
PRINT_SHOP_EMAIL=orders@example.com

# Optional: displayed in the confirmation email's sender name.
SHOP_NAME=QuickPrint

# Optional: default local development port.
PORT=3030
